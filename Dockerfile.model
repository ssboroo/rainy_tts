# Optional heavy CPU image. Build separately after reviewing upstream dependencies.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DATA_DIR=/data MODEL_DIR=/models/oron HF_HOME=/models/cache HOST=0.0.0.0 PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libgomp1 ca-certificates git build-essential && rm -rf /var/lib/apt/lists/* && useradd -m -u 10001 studio
WORKDIR /studio
COPY requirements-model.constraints.txt ./requirements-model.constraints.txt
RUN pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -c requirements-model.constraints.txt 'f5-tts @ git+https://github.com/SWivid/F5-TTS.git@283252563dbf91be625e0c27926acfaac449186c' 'oron-tts @ git+https://github.com/btseee/oron-tts.git@494c3940518cf2246fec5833b45da1a78acd7f03'
COPY app ./app
COPY scripts ./scripts
RUN mkdir /data /models && chown -R studio:studio /data /models
USER studio
EXPOSE 8080
CMD ["python", "-m", "app.server"]
