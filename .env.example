# Copy to .env; use the exact external origin, including scheme and port.
PUBLIC_ORIGIN=http://localhost:8080
ALLOW_REGISTRATION=false

# RAINY uses ElevenLabs only.
# Keep the real API key in .env / deployment secrets; never commit it.
ELEVENLABS_API_KEY=

# Optional override. Leave empty to use the 12 built-in Mongolian voices.
ELEVENLABS_VOICES_JSON=
# Example custom catalog:
# ELEVENLABS_VOICES_JSON=[{"id":"WgH4JH8sD6a2SIrujiKn","name":"Sarnai - Proud Mongolian Narrator"},{"id":"6OjaeAQxnuXC0oUZXZR2","name":"Bolor - Playful Ulaanbaatar Creator"},{"id":"sjPAZPn7M1KgdmdYfsuu","name":"Bataar - Calm Khalkha Narrator"},{"id":"2cecqSnkajrth9sJSoEH","name":"Uyanga - Kind Khalkha Friend"},{"id":"4pSHaU93d1XS027ZFhHB","name":"Oyuna - Warm Khalkha Narrator"},{"id":"ztVKSTjXnQBPBYroYARn","name":"Temuulen - Upbeat Ulaanbaatar Creator"},{"id":"49bcW9p7CyYxa3c0X0im","name":"Enkhtuya - Proud Ovorkhangai Ad"},{"id":"DLfKtGm2VGo06slN2VJE","name":"Munkhbat - Warm Khentii Creator"},{"id":"sQRZO8j8yYwJ3eCSUFy3","name":"Naran - Patient Ulaanbaatar Friend"},{"id":"Die79un8ishA33PLnH1j","name":"Batbayar - Firm Khalkha Ad"},{"id":"D9okmaITNQEQZq1w4Z1C","name":"Erdene - Blunt Ulaanbaatar Friend"},{"id":"RbMF2tQ1nCK38TfvNGLk","name":"Ganbold - Confident Khalkha Ad"}]

ELEVENLABS_LANGUAGE_CODE=mn
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
