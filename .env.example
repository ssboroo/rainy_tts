# RAINY Voice Studio
PUBLIC_ORIGIN=http://localhost:8080
# Optional comma-separated extra public origins, e.g. https://voice.example.com,https://www.voice.example.com
PUBLIC_ORIGINS=
ALLOW_REGISTRATION=true

# ElevenLabs secret: keep this server-side only.
ELEVENLABS_API_KEY=

# Optional custom voice catalog. Leave empty to use the 12 built-in Mongolian voices.
ELEVENLABS_VOICES_JSON=
ELEVENLABS_LANGUAGE_CODE=mn
ELEVENLABS_TTS_MODEL=eleven_v4

# Upload limits enforced by RAINY before sending files to ElevenLabs.
MAX_AUDIO_UPLOAD_MB=100
MAX_DUB_UPLOAD_MB=500


# RAINY subscription + credits
# Existing installs remain unmetered unless explicitly enabled.
BILLING_ENABLED=true

# Margin guard: 1 RAINY credit = $0.001 upstream API cost.
# Defaults reserve payment fees, hosting/support overhead and FX movement,
# then require at least 2.0x upstream cost coverage (100% markup).
BILLING_USD_MNT_RATE=3700
BILLING_TARGET_MARKUP=2.0
# Shared ElevenLabs backend tier + expected active paying users.
# Recommended scale: Starter<=5, Creator<=20, Pro<=100, Scale<=300, Business<=1000.
ELEVENLABS_PROVIDER_PLAN=pro
BILLING_EXPECTED_ACTIVE_USERS=100
# Conservative shared fixed-cost allocation per active paying user.
BILLING_FIXED_COST_PER_ACTIVE_USER_USD=1.25
BILLING_PAYMENT_FEE_PERCENT=3
BILLING_OVERHEAD_RESERVE_PERCENT=10
BILLING_FX_BUFFER_PERCENT=10
# Conservative fallback if a shared voice rate cannot be retrieved.
BILLING_UNKNOWN_VOICE_MULTIPLIER=2.0
# Set >0 only if you intentionally want a promotional free trial.
BILLING_TRIAL_CREDITS=0

# Wire.mn payment gateway
WIRE_MN_API_URL=https://api.wire.mn/v1
WIRE_MN_API_KEY=
WIRE_MN_WEBHOOK_SECRET=
# Test key: sandbox. Live key: use active operator IDs or leave empty so Wire chooses.
WIRE_MN_ALLOWED_OPERATORS=sandbox


# Mongolian Speech-to-Text accuracy
# Optional comma/newline-separated terms that should always be biased correctly.
STT_DEFAULT_KEYTERMS=


# Optional admin-only provider usage audit. Comma-separated RAINY account emails.
ADMIN_EMAILS=
