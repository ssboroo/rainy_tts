# Copy to .env; use the exact external origin, including scheme and port.
PUBLIC_ORIGIN=http://localhost:8080
ALLOW_REGISTRATION=false

# RAINY TTS currently uses ElevenLabs only.
# Keep the real API key in .env / deployment secrets; never commit it.
ELEVENLABS_API_KEY=

# Preferred: configure many voices as a JSON array.
# Add as many {id,name} entries as you need (up to 100 loaded by the app).
ELEVENLABS_VOICES_JSON=[{"id":"WgH4JH8sD6a2SIrujiKn","name":"RAINY Voice 01"}]

# Legacy single-voice fallback, used only when ELEVENLABS_VOICES_JSON is empty.
ELEVENLABS_VOICE_ID=WgH4JH8sD6a2SIrujiKn
ELEVENLABS_VOICE_LABEL=Монгол · Eleven v4

ELEVENLABS_LANGUAGE_CODE=mn
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
